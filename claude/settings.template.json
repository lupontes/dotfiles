{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --is-inside-work-tree 2>/dev/null && { git pull --ff-only 2>/dev/null || true; git submodule update --init --recursive 2>/dev/null || true; }",
            "timeout": 60,
            "statusMessage": "Atualizando repositório e submódulos..."
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer __GITHUB_TOKEN__"
      }
    },
    "obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-obsidian",
        "__HOME__/brain"
      ]
    }
  },
  "model": "opus"
}
